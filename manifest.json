{
  "manifest_version": 3,
  "name": "Orbit New Tab",
  "version": "1.0.0",
  "description": "A calm, beautiful space-themed new tab page with app tiles.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "windows"
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
